# ══════════════════════════════════════════════════════════════════════════
# ⚔️ KRYLOSMP 3.0 — 9,999 DEATHS HARDCORE & NOOB BAN ENGINE
# ══════════════════════════════════════════════════════════════════════════

options:
    prefix: &8[&6&lKrylo&e&lSMP&8] &r
    owner_prefix: &8[&c&l👑 OWNER&8] &c&l
    server_ip: play.krylosmp.net
    discord_link: https://discord.gg/2hSXQKHvvX

# ──────────────────────────────────────────────────────────────────────────
# 1. OWNER PREFIX & JOIN WELCOME FOR Krylo_MC
# ──────────────────────────────────────────────────────────────────────────
on join:
    if player's name is "Krylo_MC" or "Krylo_mc" or "Krylo" or "Krylo_60":
        set player's display name to "{@owner_prefix}%player%&r"
        set player's tablist name to "{@owner_prefix}%player% &7[&aLIVE&7]"
        broadcast "{@prefix} &c&l👑 SERVER OWNER &e%player% &c&lHAS JOINED THE SERVER!"
        send title "&c&lWELCOME OWNER &e%player%!" with subtitle "&79,999 Deaths Hardcore & Noob Ban Engine Active!" to player for 5 seconds
        play sound "ui.toast.challenge_complete" with volume 1.0 and pitch 1.0 to player
        
        execute console command "lp user %player% parent set owner"
    else:
        send title "&6&lWELCOME TO &e&lKRYLOSMP" with subtitle "&7Season 3 — Premium SMP Experience" to player for 5 seconds
        play sound "ui.toast.challenge_complete" with volume 1.0 and pitch 1.0 to player

# ──────────────────────────────────────────────────────────────────────────
# 2. 9,999 DEATHS HARDCORE & NOOB BAN SYSTEM
# ──────────────────────────────────────────────────────────────────────────
on death of player:
    add 1 to {krylosmp::deaths::%uuid of victim%}
    set {_deaths} to {krylosmp::deaths::%uuid of victim%}
    
    send "{@prefix} &c💀 Death Counter: &e%{_deaths}% / 9999" to victim
    
    if {_deaths} >= 9999:
        set victim's gamemode to spectator
        broadcast "{@prefix} &c&l💀 ULTIMATE NOOB ELIMINATION!"
        broadcast "{@prefix} &e%victim% &c&lREACHED 9,999 DEATHS, ENTERED HARDCORE MODE, AND WAS BANNED FOR BEING A NOOB!"
        play sound "entity.wither.death" with volume 1.0 to all players
        
        wait 2 seconds
        execute console command "ban %victim% &c&lHARDCORE ELIMINATION! &7You reached 9,999 deaths and were banned for being a noob! 💀"

command /resetdeaths [<player>]:
    permission: op
    trigger:
        set {_p} to arg-1
        if {_p} is not set:
            set {_p} to player
        set {krylosmp::deaths::%uuid of {_p}%} to 0
        send "{@prefix} &aReset death counter to 0 for %{_p}%!" to player

command /deaths [<player>]:
    trigger:
        set {_p} to arg-1
        if {_p} is not set:
            set {_p} to player
        send "{@prefix} &f%player%'s Deaths: &c%{krylosmp::deaths::%uuid of {_p}%} || 0% &7/ 9999 (Hardcore Ban Limit)" to player

# ──────────────────────────────────────────────────────────────────────────
# 3. GOD FOOD ENGINE (+30 HEARTS PERMANENT & SATURATION 255)
# ──────────────────────────────────────────────────────────────────────────
command /godfood [<player>]:
    executable by: players and console
    trigger:
        set {_p} to arg-1
        if {_p} is not set:
            set {_p} to player
            
        set {_food} to enchanted golden apple
        set name of {_food} to "&6&l🍖 God Food of Krylo &7(&e&l+30 Hearts Forever&7)"
        set line 1 of lore of {_food} to "&7&oLegendary Ambrosia created by the Storm Gods."
        set line 2 of lore of {_food} to "&e&lEFFECT 1: &f+30 Extra Hearts Forever (Until Milk)"
        set line 3 of lore of {_food} to "&e&lEFFECT 2: &fSaturation 255 for 10 Seconds"
        set line 4 of lore of {_food} to "&6&lRETEXTURED MODEL DATA: &e#1015"
        set custom model data of {_food} to 1015
        
        give 64 of {_food} to {_p}
        send "{@prefix} &aGranted 64x &6🍖 God Food of Krylo &ato %{_p}%!" to {_p}

command /godkit [<player>]:
    executable by: players and console
    trigger:
        set {_p} to arg-1
        if {_p} is not set:
            set {_p} to player

        execute console command "minecraft:clear %{_p}%"
        execute console command "godspear %{_p}%"
        
        set {_i2} to netherite sword
        set name of {_i2} to "&c&l🗡️ Blade of Chaos &7(&4&lGod Sword&7)"
        set line 1 of lore of {_i2} to "&7&oForged in the Nethemelt Abyss."
        set line 2 of lore of {_i2} to "&c&lABILITY: &fInfernal Lifesteal & Firewave"
        set line 3 of lore of {_i2} to "&6&lRETEXTURED MODEL DATA: &e#1002"
        enchant {_i2} with sharpness 10
        enchant {_i2} with fire aspect 5
        enchant {_i2} with looting 5
        enchant {_i2} with unbreaking 5
        enchant {_i2} with mending 1
        set custom model data of {_i2} to 1002
        give 1 of {_i2} to {_p}

        set {_i3} to shield
