# ====================================================================================
# 👑 KRYLOSMP 3.0 MEGA FEATURES & GOD RELICS ENGINE (.SK)
# ====================================================================================

options:
    prefix: &6&l[KryloSMP]&r

# ------------------------------------------------------------------------------------
# 1. PLAYER JOIN & VERIFICATION SYSTEM
# ------------------------------------------------------------------------------------
on join:
    send "{@prefix} &b&l[Verification] &eYour 5-Digit Web Verification Code is: &a&l77777" to player
    send "{@prefix} &a&lEnter &a77777 &fon the Web Portal to log in!" to player
    
    if {deaths::%uuid of player%} is not set:
        set {deaths::%uuid of player%} to 0
    if {deaths::%uuid of player%} >= 9999:
        make console execute command "/gamemode spectator %player%"
        send "&c&l[KryloSMP Hardcore] &4&lYOU HAVE EXCEEDED 9,999 DEATHS! SPECTATOR MODE ENFORCED!" to player

on command "/verify":
    send "{@prefix} &b&l[Verification] &eYour 5-Digit Code is: &a&l77777" to player

# ------------------------------------------------------------------------------------
# 2. FULL GOD RELICS KIT COMMAND FOR OWNER & VIPs
# ------------------------------------------------------------------------------------
command /godkit [<player>]:
    permission: krylosmp.admin
    trigger:
        set {_p} to arg-1
        if {_p} is not set:
            set {_p} to player
            
        set {_i11} to netherite chestplate
        set name of {_i11} to "&c&l🛡️ God Chestplate of Krylo"
        set line 1 of lore of {_i11} to "&7&oInvincible barrier armor."
        set line 2 of lore of {_i11} to "&c&lABILITY: &fDamage Reduction & Thorns V"
        set line 3 of lore of {_i11} to "&6&lRETEXTURED MODEL DATA: &e#1011"
        enchant {_i11} with protection 10
        enchant {_i11} with thorns 5
        enchant {_i11} with unbreaking 5
        enchant {_i11} with mending 1
        set custom model data of {_i11} to 1011
        give 1 of {_i11} to {_p}
        
        set {_i12} to netherite boots
        set name of {_i12} to "&a&l👢 Hermes Speed Boots"
        set line 1 of lore of {_i12} to "&7&oBoots of the speed god."
        set line 2 of lore of {_i12} to "&a&lABILITY: &fSpeed IV & Double Jump"
        set line 3 of lore of {_i12} to "&6&lRETEXTURED MODEL DATA: &e#1012"
        enchant {_i12} with protection 10
        enchant {_i12} with feather falling 10
        enchant {_i12} with depth strider 3
        enchant {_i12} with soul speed 3
        enchant {_i12} with unbreaking 5
        enchant {_i12} with mending 1
        set custom model data of {_i12} to 1012
        give 1 of {_i12} to {_p}
        
        set {_i13} to netherite leggings
        set name of {_i13} to "&e&l👖 God Leggings of Krylo"
        set line 1 of lore of {_i13} to "&7&oPants infused with titan power."
        set line 2 of lore of {_i13} to "&e&lABILITY: &fProtection X & Swift Sneak III"
        set line 3 of lore of {_i13} to "&6&lRETEXTURED MODEL DATA: &e#1013"
        enchant {_i13} with protection 10
        enchant {_i13} with swift sneak 3
        enchant {_i13} with unbreaking 5
        enchant {_i13} with mending 1
        set custom model data of {_i13} to 1013
        give 1 of {_i13} to {_p}
        
        execute console command "godfood %{_p}%"

command /godfood [<player>]:
    permission: krylosmp.admin
    trigger:
        set {_p} to arg-1
        if {_p} is not set:
            set {_p} to player
        set {_gfood} to 64 of enchanted golden apple
        set name of {_gfood} to "&6&l🍖 God Food of Krylo"
        set line 1 of lore of {_gfood} to "&7Saturation 255 (10s) & +30 Extra Hearts FOREVER"
        give {_gfood} to {_p}
        send "{@prefix} &a&lDelivered 64x God Food to &e%{_p}%&a!" to player

# ------------------------------------------------------------------------------------
# 3. CONSUMABLE EVENTS: SATURATION 255 (10s) & +30 HEARTS FOREVER (UNTIL MILK)
# ------------------------------------------------------------------------------------
on consume of enchanted golden apple:
    apply saturation 255 to player for 10 seconds
    apply health boost 15 to player for 999999 seconds
    heal player by 30 hearts
    send "{@prefix} &6&l🍖 GOD FOOD EATEN! &e+30 EXTRA HEARTS ACTIVATED FOREVER (UNTIL MILK) & SATURATION 255!" to player
    play sound "entity.player.burp" with volume 1.0 and pitch 1.0 to player

# ------------------------------------------------------------------------------------
# 4. HARDCORE 9,999 DEATHS COUNTER
# ------------------------------------------------------------------------------------
on death of player:
    add 1 to {deaths::%uuid of victim%}
    send "&c&l[KryloSMP Deaths] &eTotal Deaths: &c%{deaths::%uuid of victim%}% / 9999" to victim
    if {deaths::%uuid of victim%} >= 9999:
        make console execute command "/gamemode spectator %victim%"
        broadcast "&4&l[HARDCORE BAN] &c%victim% reached 9,999 deaths and has been converted to SPECTATOR!"
